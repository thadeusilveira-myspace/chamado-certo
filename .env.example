# --- Frontend (Vite) ---
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=chave-anon-do-projeto

# --- Funções serverless (/api) — configurar no Vercel ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=chave-service-role-NUNCA-expor-no-frontend

# Token que a Evolution API manda na URL do webhook (invente um valor longo)
EVOLUTION_WEBHOOK_TOKEN=um-token-secreto-longo

# Gateway Evolution API (opcional — sem isso o envio pelo sistema fica desativado,
# mas copiar mensagem / abrir no WhatsApp continuam funcionando)
EVOLUTION_API_URL=https://sua-evolution.exemplo.com
EVOLUTION_API_KEY=apikey-da-evolution
EVOLUTION_INSTANCE=nome-da-instancia

# IA comercial (opcional — habilita "Gerar com IA" no Radar e a extração de
# fatos das conversas; sem a chave, as sugestões heurísticas continuam funcionando)
ANTHROPIC_API_KEY=sk-ant-...
